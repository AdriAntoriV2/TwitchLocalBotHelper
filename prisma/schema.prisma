generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ChatCommand {
  id              String   @id @default(uuid())
  name            String   @unique
  enabled         Boolean  @default(true)
  cooldownSeconds Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  response        String

  @@index([enabled])
}

model FirstRedemption {
  id                 String   @id @default(uuid())
  streamId           String   @unique
  twitchRedemptionId String   @unique
  userId             String
  userLogin          String
  userDisplayName    String
  redeemedAt         DateTime
  createdAt          DateTime @default(now())

  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([redeemedAt])
}

model PointPoolAdjustment {
  id               String   @id @default(uuid())
  amount           Int
  attribution      String   @default("GreedyKAITO")
  reason           String?
  createdAt        DateTime @default(now())
  pointPoolEventId String

  pointPoolEvent PointPoolEvent @relation(fields: [pointPoolEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([pointPoolEventId, createdAt])
}

model PointPoolEvent {
  id        String    @id @default(uuid())
  name      String
  status    String    @default("DRAFT")
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  redemptions PointPoolRedemption[]
  goals       PointPoolGoal[]
  adjustments PointPoolAdjustment[]

  @@index([status])
  @@index([createdAt])
}

model PointPoolGoal {
  id               String   @id @default(uuid())
  targetPoints     Int
  description      String
  createdAt        DateTime @default(now())
  pointPoolEventId String

  pointPoolEvent PointPoolEvent @relation(fields: [pointPoolEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([pointPoolEventId, createdAt])
}

model PointPoolRedemption {
  id                 String   @id @default(uuid())
  twitchRedemptionId String   @unique
  userId             String
  userLogin          String
  userDisplayName    String
  rewardId           String
  rewardTitle        String
  pointsCost         Int
  redeemedAt         DateTime
  createdAt          DateTime @default(now())
  pointPoolEventId   String

  pointPoolEvent PointPoolEvent @relation(fields: [pointPoolEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([pointPoolEventId, redeemedAt])
  @@index([userId])
}

model Stream {
  id        String    @id @default(uuid())
  title     String
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  events          StreamEvent[]
  firstRedemption FirstRedemption?

  @@index([startedAt])
}

model StreamEvent {
  id         String   @id @default(uuid())
  streamId   String
  type       String
  payload    Json
  createdAt  DateTime @default(now())
  externalId String?  @unique

  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([streamId])
  @@index([type])
  @@index([createdAt])
}

model TwitchAccount {
  id                    String   @id @default(uuid())
  twitchUserId          String   @unique
  login                 String
  displayName           String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  accessTokenExpiresAt  DateTime
  scopes                Json?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tokenVersion          Int      @default(1)

  @@index([login])
}

model NeonMigrationHistory {
  id                  String  @id
  checksum            String
  finished_at         String?
  migration_name      String
  logs                String?
  rolled_back_at      String?
  started_at          String
  applied_steps_count Int     @default(0)
}
